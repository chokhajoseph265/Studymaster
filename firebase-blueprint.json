{
  "entities": {
    "users": {
      "title": "users",
      "description": "Student and admin profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "emailOrPhone": { "type": "string" },
        "avatarId": { "type": "string" },
        "activeForm": { "type": "string" },
        "points": { "type": "number" },
        "weeklyPoints": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "isPremium": { "type": "boolean" },
        "premiumExpiry": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["id", "username", "activeForm", "points", "weeklyPoints"]
    },
    "notes": {
      "title": "notes",
      "description": "Syllabus notes and curriculum lessons",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "title": { "type": "string" },
        "form": { "type": "string" },
        "content": { "type": "string" },
        "estimatedReadTimeMinutes": { "type": "number" },
        "version": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "topicId", "title", "form", "content"]
    },
    "quizzes": {
      "title": "quizzes",
      "description": "Practice quizzes and examinations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "form": { "type": "string" },
        "topicId": { "type": "string" },
        "questions": { "type": "array" }
      },
      "required": ["id", "title", "form"]
    },
    "pastPapers": {
      "title": "pastPapers",
      "description": "MANEB past examinations (MSCE/JCE)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "form": { "type": "string" },
        "category": { "type": "string" },
        "year": { "type": "number" }
      },
      "required": ["id", "title", "form", "year"]
    },
    "payments": {
      "title": "payments",
      "description": "Mobile money and subscription records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "amountMWK": { "type": "number" },
        "method": { "type": "string" },
        "referenceCode": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amountMWK", "status"]
    },
    "announcements": {
      "title": "announcements",
      "description": "Curriculum broadcasts and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
